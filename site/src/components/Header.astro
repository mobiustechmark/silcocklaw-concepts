---
const links = [
  { href: '/', label: 'Home' },
  { href: '/about/', label: 'About' },
  { href: '/services/', label: 'Services' },
];
const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="sticky top-0 z-40 border-b border-slate-100 bg-white/95 backdrop-blur">
  <div class="mx-auto flex min-h-20 max-w-6xl items-center justify-between px-6 py-2">
    <a href="/" class="block" aria-label="Silcock Law home">
      <img src="/logo/silcocklaw-logo.svg" alt="Silcock Law" width="371" height="96" class="h-14 w-auto md:h-24" />
    </a>
    <nav class="hidden items-center gap-9 text-sm font-medium tracking-wide md:flex" aria-label="Main">
      {links.map((l) => (
        <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}
           class:list={['uppercase transition hover:text-accent-dark', isCurrent(l.href) && 'text-accent-dark']}>{l.label}</a>
      ))}
      <a href="/contact/" class="inline-flex items-center rounded-full bg-brand px-5 py-2.5 uppercase text-white transition hover:bg-brand-light">Contact</a>
    </nav>
    <button id="navBtn" type="button" class="-mr-2 p-2 text-brand md:hidden" aria-label="Open menu" aria-expanded="false" aria-controls="navMenu">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
  </div>
  <nav id="navMenu" class="hidden border-t border-slate-100 bg-white px-4 py-3 text-sm font-medium md:hidden" aria-label="Mobile">
    {[...links, { href: '/contact/', label: 'Contact' }].map((l) => (
      <a href={l.href} class="block rounded-lg px-3 py-3 uppercase text-brand hover:bg-slate-50">{l.label}</a>
    ))}
  </nav>
</header>
<script>
  const btn = document.getElementById('navBtn');
  const menu = document.getElementById('navMenu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      const open = menu.classList.toggle('hidden') === false;
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.classList.contains('hidden')) {
        menu.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
        btn.focus();
      }
    });
  }
</script>
