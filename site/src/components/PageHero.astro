---
interface Props { eyebrow: string; title: string; }
const { eyebrow, title } = Astro.props;
---
<section class="relative overflow-hidden bg-brand text-white">
  <div class="absolute inset-0 bg-gradient-to-b from-white/10 to-black/20"></div>
  <div class="above mx-auto max-w-6xl px-6 py-16 md:py-20">
    <p class="mb-4 text-base font-semibold tracking-[0.2em] text-accent">{eyebrow}</p>
    <h1 class="font-heading max-w-3xl text-4xl leading-[1.1] md:text-6xl">{title}</h1>
    <slot />
  </div>
</section>
