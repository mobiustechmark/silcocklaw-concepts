---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ServiceCards from '../components/ServiceCards.astro';
import ClosingCta from '../components/ClosingCta.astro';
---
<Base title="Services" description="Governance, compliance, commercial, employment and risk management advice for not-for-profit organisations.">
  <PageHero eyebrow="SERVICES" title="How Silcock Law can help">
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-200">Jo’s experience and expertise spans the areas not-for-profits most often need support.</p>
  </PageHero>
  <section>
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-24"><ServiceCards /></div>
  </section>
  <ClosingCta />
</Base>
